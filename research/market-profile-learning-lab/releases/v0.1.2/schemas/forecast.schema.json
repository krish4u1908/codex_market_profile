{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BANKNIFTY_MARKET_PROFILE_FORECAST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "candidate_id",
    "horizon_minutes",
    "what_changed",
    "bias",
    "support",
    "resistance",
    "invalidation",
    "confidence",
    "classification"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "BANKNIFTY_MARKET_PROFILE_FORECAST_V1"
    },
    "case_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "horizon_minutes": {"type": "integer", "enum": [5, 15, 30]},
    "what_changed": {"type": "string"},
    "bias": {
      "type": "string",
      "enum": ["UP", "DOWN", "ROTATION", "NO_EDGE"]
    },
    "support": {"type": "array", "items": {"type": "number"}, "maxItems": 3},
    "resistance": {"type": "array", "items": {"type": "number"}, "maxItems": 3},
    "invalidation": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "classification": {
      "type": "string",
      "const": "POSSIBLE_OUTCOME_RESEARCH_ONLY"
    }
  }
}
