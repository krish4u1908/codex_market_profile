[Unit]
Description=NIFTY V3 core
After=network.target

[Service]
Type=simple
User=bankadmin
Group=bankadmin
WorkingDirectory=/opt/market-workspace-v3/current/core
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0027
SupplementaryGroups=marketdata
RuntimeDirectory=market-core-nifty
ReadOnlyPaths=/opt/nifty-collector/data-prod-nifty
ReadWritePaths=/var/lib/market-workspace-v3/nifty
ExecStart=/opt/market-workspace-v3/current/.venv/bin/python -m market_core.server --config /opt/market-workspace-v3/current/config/nifty.json
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
