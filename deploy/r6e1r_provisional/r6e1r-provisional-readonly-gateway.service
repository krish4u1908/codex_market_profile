[Unit]
Description=R6E1R PROVISIONAL sanitized read-only gateway (full-six pending)
Documentation=file://@R6E1R_REPOSITORY_ROOT@/deploy/r6e1r_provisional/README.md
After=r6e1r-provisional-shadow.service
Conflicts=r6e1r-readonly-gateway.service
StartLimitIntervalSec=5min
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@R6E1R_REPOSITORY_ROOT@
UMask=0077
UnsetEnvironment=SSH_AUTH_SOCK DBUS_SESSION_BUS_ADDRESS LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH LD_DEBUG LD_DEBUG_OUTPUT LD_PROFILE GCONV_PATH GLIBC_TUNABLES LOCPATH NLSPATH PYTHONPATH PYTHONHOME PYTHONINSPECT PYTHONSTARTUP PYTHONBREAKPOINT ENV BASH_ENV TMPDIR TMP TEMP
KeyringMode=private
ExecStart=/usr/bin/bwrap --unshare-all --unshare-user --share-net --disable-userns --assert-userns-disabled --die-with-parent --new-session --cap-drop ALL --clearenv --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind @R6E1R_REPOSITORY_ROOT@/deploy/r6e1r /app/deploy/r6e1r --dev /dev --proc /proc --tmpfs /tmp --dir /run --chdir /app /usr/bin/python3 -I -S -B -X pycache_prefix=/dev/null -c 'import hashlib,sys;origin=sys.argv[1];p=open(origin,"rb").read();None if hashlib.sha256(p).hexdigest()=="a875953704ff89045bae47604e68fbcbf472efcf7f650d689151d43aec376279" else sys.exit(1);sys.argv=[origin,*sys.argv[2:]];g={"__name__":"__main__","__file__":origin,"__package__":None,"__cached__":None};exec(compile(p,origin,"exec"),g,g)' /app/deploy/r6e1r/read_only_gateway.py --bind 0.0.0.0 --port @R6E1R_GATEWAY_PORT@ --backend http://127.0.0.1:18805 --hidden-path @R6E1R_COLLECTOR_ROOT@ --hidden-path @R6E1R_DEPLOY_ROOT@/state --hidden-path @R6E1R_DEPLOY_ROOT@/config --require-isolation
ExecStartPost=/usr/bin/bwrap --unshare-all --unshare-user --share-net --disable-userns --assert-userns-disabled --die-with-parent --new-session --cap-drop ALL --clearenv --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind @R6E1R_REPOSITORY_ROOT@/deploy/r6e1r /app/deploy/r6e1r --dev /dev --proc /proc --tmpfs /tmp --dir /run --chdir /app /usr/bin/python3 -I -S -B -X pycache_prefix=/dev/null -c 'import hashlib,sys;origin=sys.argv[1];p=open(origin,"rb").read();None if hashlib.sha256(p).hexdigest()=="42ea7f0312fdca5a542ca99dc4c738d263e0f12f15f0135a02c790bb0b39a67b" else sys.exit(1);sys.argv=[origin,*sys.argv[2:]];g={"__name__":"__main__","__file__":origin,"__package__":None,"__cached__":None};exec(compile(p,origin,"exec"),g,g)' /app/deploy/r6e1r/health_readiness_check.py --base-url http://127.0.0.1:@R6E1R_GATEWAY_PORT@ --attempts 30 --delay-seconds 1 --timeout-seconds 0.25
Restart=on-failure
RestartSec=3s
TimeoutStartSec=75s
TimeoutStopSec=30s
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=128
LimitNOFILE=4096
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=@R6E1R_REPOSITORY_ROOT@
InaccessiblePaths=-@R6E1R_COLLECTOR_ROOT@ -@R6E1R_DEPLOY_ROOT@/state -@R6E1R_DEPLOY_ROOT@/config -%t/gnupg
ProtectControlGroups=true
ProtectKernelModules=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=~net
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=r6e1r-provisional-readonly-gateway
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000

[Install]
WantedBy=default.target
