[Unit]
Description=R6E1R localhost analytical shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=banknifty-profiler
Group=banknifty-profiler
WorkingDirectory=/opt/banknifty/repositories/banknifty-market-profiler
ExecStart=/opt/banknifty/research/.venv/bin/python -B scripts/run_r6e_shadow.py --data-root /opt/banknifty-collector/data-prod-v4 --state-root /var/lib/banknifty-profiler/r6e1r --config configs/r6e_shadow.json --bind 127.0.0.1 --port 18805 --mode shadow --activation /etc/banknifty-profiler/r6e1r-activation.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
MemoryHigh=5G
MemoryMax=6G
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/banknifty-collector/data-prod-v4 /opt/banknifty/repositories/banknifty-market-profiler /etc/banknifty-profiler
ReadWritePaths=/var/lib/banknifty-profiler/r6e1r
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=r6e1r-shadow

[Install]
WantedBy=multi-user.target
