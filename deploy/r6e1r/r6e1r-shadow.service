[Unit]
Description=R6E1R localhost analytical live shadow (user service)
Documentation=file://@R6E1R_REPOSITORY_ROOT@/deploy/r6e1r/README.md
StartLimitIntervalSec=5min
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@R6E1R_REPOSITORY_ROOT@
UMask=0077
UnsetEnvironment=SSH_AUTH_SOCK DBUS_SESSION_BUS_ADDRESS LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH LD_DEBUG LD_DEBUG_OUTPUT LD_PROFILE GCONV_PATH GLIBC_TUNABLES LOCPATH NLSPATH PYTHONPATH PYTHONHOME PYTHONINSPECT PYTHONSTARTUP PYTHONBREAKPOINT ENV BASH_ENV TMPDIR TMP TEMP
KeyringMode=private
ExecStartPre=/usr/bin/test -r @R6E1R_COLLECTOR_ROOT@/raw
ExecStartPre=/usr/bin/test -r @R6E1R_COLLECTOR_ROOT@/oi
ExecStartPre=/usr/bin/test -w @R6E1R_DEPLOY_ROOT@/state
ExecStartPre=/usr/bin/test -r @R6E1R_DEPLOY_ROOT@/config/r6e1r-runtime-config.json
ExecStartPre=/usr/bin/test -r @R6E1R_DEPLOY_ROOT@/config/r6e1r-activation.json
ExecStart=/bin/sh -c 'exec 3<@R6E1R_REPOSITORY_ROOT@/scripts/run_r6e_shadow.py && exec 4<@R6E1R_DEPLOY_ROOT@/config/r6e1r-runtime-config.json && exec 5<@R6E1R_DEPLOY_ROOT@/config/r6e1r-activation.json && exec @R6E1R_PYTHON@ -I -S -B -u -X pycache_prefix=/dev/null -c "import hashlib,sys;r=open(\"/proc/self/fd/3\",\"rb\").read();c=open(\"/proc/self/fd/4\",\"rb\").read();a=open(\"/proc/self/fd/5\",\"rb\").read();ok=(hashlib.sha256(r).hexdigest()==\"17f0d6c2f8648f72952d9c02266d575f689b23df21651f6936d93c09e7067d32\" and hashlib.sha256(c).hexdigest()==\"c38479baeefe25c4cc47981d5ad86cf5538b20aa0eb1ae6fab2fade1c1a58364\" and hashlib.sha256(a).hexdigest()==\"e12ee801eb939b5d1633eda3edcd4123fc7e9a935cf2fa037d6428b57ad9e95f\");None if ok else sys.exit(1);origin=\"@R6E1R_REPOSITORY_ROOT@/scripts/run_r6e_shadow.py\";sys.argv=[origin,*sys.argv[1:]];g={\"__name__\":\"__main__\",\"__file__\":origin,\"__package__\":None,\"__cached__\":None,\"_R6E1R_AUTHENTICATED_CONFIG_PAYLOAD\":c,\"_R6E1R_AUTHENTICATED_ACTIVATION_PAYLOAD\":a};exec(compile(r,origin,\"exec\"),g,g)" --repository-root @R6E1R_REPOSITORY_ROOT@ --data-root @R6E1R_COLLECTOR_ROOT@ --state-root @R6E1R_DEPLOY_ROOT@/state --config @R6E1R_DEPLOY_ROOT@/config/r6e1r-runtime-config.json --bind 127.0.0.1 --port 18805 --mode shadow --activation @R6E1R_DEPLOY_ROOT@/config/r6e1r-activation.json'
ExecStartPost=/bin/sh -c 'exec 3<@R6E1R_REPOSITORY_ROOT@/deploy/r6e1r/health_readiness_check.py && exec @R6E1R_PYTHON@ -I -S -B -X pycache_prefix=/dev/null -c "import hashlib,sys;p=open(\"/proc/self/fd/3\",\"rb\").read();None if hashlib.sha256(p).hexdigest()==\"42ea7f0312fdca5a542ca99dc4c738d263e0f12f15f0135a02c790bb0b39a67b\" else sys.exit(1);origin=\"@R6E1R_REPOSITORY_ROOT@/deploy/r6e1r/health_readiness_check.py\";sys.argv=[origin,*sys.argv[1:]];g={\"__name__\":\"__main__\",\"__file__\":origin,\"__package__\":None,\"__cached__\":None};exec(compile(p,origin,\"exec\"),g,g)" --base-url http://127.0.0.1:18805 --attempts 600 --delay-seconds 1 --timeout-seconds 0.25'
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
TimeoutStopSec=60s
KillSignal=SIGTERM
MemoryHigh=8G
MemoryMax=10G
MemorySwapMax=0
CPUQuota=200%
TasksMax=512
LimitNOFILE=65536
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ReadOnlyPaths=@R6E1R_COLLECTOR_ROOT@ @R6E1R_REPOSITORY_ROOT@ @R6E1R_DEPLOY_ROOT@/config
ReadWritePaths=@R6E1R_DEPLOY_ROOT@/state
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=r6e1r-shadow
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000

[Install]
WantedBy=default.target
